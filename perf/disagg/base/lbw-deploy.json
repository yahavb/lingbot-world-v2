{
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
        "name": "lbw-v2",
        "namespace": "default"
    },
    "spec": {
        "replicas": 1,
        "selector": {
            "matchLabels": {
                "app": "lbw-v2"
            }
        },
        "strategy": {
            "type": "Recreate"
        },
        "template": {
            "metadata": {
                "labels": {
                    "app": "lbw-v2"
                }
            },
            "spec": {
                "affinity": {
                    "nodeAffinity": {
                        "preferredDuringSchedulingIgnoredDuringExecution": [
                            {
                                "preference": {
                                    "matchExpressions": [
                                        {
                                            "key": "kubernetes.io/hostname",
                                            "operator": "In",
                                            "values": [
                                                "ip-192-168-192-137.us-east-2.compute.internal"
                                            ]
                                        }
                                    ]
                                },
                                "weight": 100
                            }
                        ]
                    }
                },
                "containers": [
                    {
                        "command": [
                            "/bin/bash",
                            "-c",
                            "set -euo pipefail\ngit clone -b \"$BRANCH\" https://github.com/yahavb/lingbot-world-v2.git /tmp/lingbot\ncd /tmp/lingbot\necho \"commit: $(git log --oneline -1)\"\n# enhanced neuron-top (op names in the memory layout, EFA traffic), from the repo\ninstall -m 755 tools/neuron-top/neuron-monitor-top.py \"$(command -v neuron-monitor-top.py || echo /opt/aws/neuron/bin/neuron-monitor-top.py)\" \\\n  \u0026\u0026 echo \"neuron-top: enhanced\" || echo \"neuron-top: stock\"\nNODE=/node-cache; mkdir -p \"$NODE\"\nCKPT=$NODE/lingbot-world-v2-14b-causal-fast\n# compile caches on the node, namespaced by CACHE_VERSION (env below): the first pod on a node fills\n# them, every later pod there reuses them; bump CACHE_VERSION when pulling new model/kernel code\nC=$NODE/cache/v${CACHE_VERSION:?set CACHE_VERSION}\nexport NEURON_COMPILE_CACHE_URL=$C/neuron-compile-cache\nexport TORCH_NEURONX_NEFF_CACHE_DIR=$C/neff_cache\nexport NKI_ENABLE_TRACE_CACHE=\"${NKI_ENABLE_TRACE_CACHE:-1}\"\nexport TORCH_NEURONX_HLO_CACHE_DIR=$C/hlo_cache\nmkdir -p \"$NEURON_COMPILE_CACHE_URL\" \"$TORCH_NEURONX_NEFF_CACHE_DIR\" \"$TORCH_NEURONX_HLO_CACHE_DIR\" \"$C/nki-intermediate-cache\"\n# compiled graphs reference NKI kernel binaries by path under /var/tmp: keep them with the cache\nrm -rf /var/tmp/nki-intermediate-cache \u0026\u0026 ln -s \"$C/nki-intermediate-cache\" /var/tmp/nki-intermediate-cache\necho \"neff cache on node (v$CACHE_VERSION): $(find \"$TORCH_NEURONX_NEFF_CACHE_DIR\" -name '*.neff' 2\u003e/dev/null | wc -l) NEFFs\"\nexport HF_HOME=/tmp/hf-cache\n\npip install -q -r requirements_neuron.txt huggingface_hub fastapi uvicorn\npython3 -c \"import torchvision\" 2\u003e/dev/null || bash install_neuron.sh\n\n# checkpoint: download + convert once per node (flock; .complete marks a finished entry)\nflock \"$NODE/ckpt.lock\" bash -c '\n  [ -f \"$1/.complete\" ] \u0026\u0026 { echo \"ckpt: on node cache\"; exit 0; }\n  hf download robbyant/lingbot-world-v2-14b-causal-fast --local-dir \"$1\"\n  [ -f \"$1/transformers/config.json\" ] || cp \"$1/config.json\" \"$1/transformers/config.json\"\n  python3 scripts/inference/convert_dit_to_pth.py --ckpt_dir \"$1\"\n  rm -f \"$1\"/transformers/*.safetensors\n  touch \"$1/.complete\"' _ \"$CKPT\"\n\npython3 scripts/analysis/qk_gamma_temperature.py --ckpt_dir \"$CKPT\" | tee /tmp/qk.txt\nexport FLASH_ATTN_LAYERS=$(grep -oE \"CANDIDATE HOT LAYERS \\([0-9]+\\): [0-9,]+\" /tmp/qk.txt | sed -E \"s/.*: //\" || true)\n\nNEURON_LOGICAL_NC_CONFIG=\"$LNC\" torchrun --nproc_per_node=\"$NPROC\" serve.py \\\n  --task i2v-A14B --infer_mode causal_fast --ckpt_dir \"$CKPT\" \\\n  --size \"$SIZE\" --frame_num \"$FRAME_NUM\" --chunk_size \"$CHUNK_SIZE\" \\\n  --image examples/03/image.jpg --action_path examples/03 --prompt \"$PROMPT\" \\\n  --tp_degree \"$TP\" --cp_size \"$CP\" --denoise_steps \"$DENOISE_STEPS\" \\\n  --local_attn_size \"$LOCAL_ATTN_SIZE\" --sink_size \"$SINK_SIZE\" --base_seed 42 2\u003e\u00261 \\\n  | tee -a /logs/serve.log | grep --line-buffered -avE \"AliasingInfo|Mutated inputs|Detected collective\"\n"
                        ],
                        "env": [
                            {
                                "name": "CACHE_VERSION",
                                "value": "6"
                            },
                            {
                                "name": "LINGBOT_REANCHOR_FRAMES",
                                "value": "800"
                            },
                            {
                                "name": "BRANCH",
